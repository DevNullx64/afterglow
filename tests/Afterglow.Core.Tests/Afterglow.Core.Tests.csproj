<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport stubs (CommandLineTests calls the real Windows argv parser). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Underscore-separated test names are the xUnit naming convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Afterglow.Core\Afterglow.Core.csproj" />
  </ItemGroup>

  <!-- The CLI's argument parsing, compiled in so it is tested without running
       the exe (whose write commands would open the GPU). Parsing only — no
       test calls Run. -->
  <ItemGroup>
    <Compile Include="..\..\src\Afterglow.Cli\CliGpu.cs" Link="Cli\CliGpu.cs" />
    <Compile Include="..\..\src\Afterglow.Cli\VfPointsCommand.cs" Link="Cli\VfPointsCommand.cs" />
  </ItemGroup>

</Project>
