<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables (Microsoft.Testing.Platform, see global.json). -->
    <OutputType>Exe</OutputType>
    <!-- LibraryImport stubs (CommandLineTests calls the real Windows argv parser). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Underscore-separated test names are the xUnit naming convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Afterglow.Core\Afterglow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window-effects version gate is pure C# inside the WPF app; compile that one
         file in (WindowEffectsPlanTests) instead of referencing the WinExe. -->
    <Compile Include="..\..\src\Afterglow.App\Shell\WindowEffectsPlan.cs" Link="Shell\WindowEffectsPlan.cs" />
  </ItemGroup>

</Project>
