<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Afterglow dark palette. Single deliberate dark look; ember accent. -->

    <Color x:Key="Bg0Color">#0C0F14</Color>
    <Color x:Key="Bg1Color">#12161D</Color>
    <Color x:Key="Bg2Color">#191F28</Color>
    <Color x:Key="Bg3Color">#222B37</Color>
    <Color x:Key="StrokeColor">#2A3341</Color>
    <Color x:Key="StrokeSoftColor">#1E2530</Color>
    <Color x:Key="TextColor">#E8EDF4</Color>
    <Color x:Key="TextMutedColor">#97A1AE</Color>
    <Color x:Key="TextFaintColor">#5D6875</Color>
    <Color x:Key="AccentColor">#FF8A3C</Color>
    <Color x:Key="AccentHoverColor">#FFA05C</Color>
    <Color x:Key="AccentSoftColor">#33FF8A3C</Color>
    <Color x:Key="GoodColor">#46C36B</Color>
    <Color x:Key="WarnColor">#E8B33C</Color>
    <Color x:Key="BadColor">#F0564A</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeSoft" Color="{StaticResource StrokeSoftColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFaint" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="Good" Color="{StaticResource GoodColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="Bad" Color="{StaticResource BadColor}" />

    <!-- Warning surfaces: the crash banners and the "monitoring only" title-bar badge. -->
    <Color x:Key="WarnSurfaceColor">#2E1E12</Color>
    <Color x:Key="WarnSoftColor">#33E8B33C</Color>
    <SolidColorBrush x:Key="WarnSurface" Color="{StaticResource WarnSurfaceColor}" />
    <SolidColorBrush x:Key="WarnSoft" Color="{StaticResource WarnSoftColor}" />

    <!-- Window surfaces. MainWindow refers to these with DynamicResource: they are opaque
         by default (the classic look, and the fallback on Windows 10, high contrast,
         transparency effects off, or the no-mica switch). When DWM accepts the Mica backdrop,
         MainWindow swaps in the *Mica variants: the same palette colours with alpha, so
         the wallpaper-tinted material shows through as a hint of depth while cards (Bg2)
         stay opaque and keep the hierarchy. Mica's dark base (~#202020 plus tint) is
         lighter than Bg0, so the content tint stays nearly opaque (91 %) and the chrome
         tint at 75 %. Measured on Windows 11 25H2 over a black wallpaper (backdrop ~#222222,
         active and inactive alike): chrome #16191E instead of #12161D, content #0E1115
         instead of #0C0F14. A colourful wallpaper tints those slightly; not measured. -->
    <SolidColorBrush x:Key="ChromeSurface" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="ContentSurface" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="ChromeSurfaceMica" Color="#C012161D" />
    <SolidColorBrush x:Key="ContentSurfaceMica" Color="#E80C0F14" />

    <!-- Behind the caption buttons. With the frame extended into the client area, DWM still
         draws its own min/max/close glyphs in the frame under the title bar; a translucent
         title bar lets them ghost through. This strip is opaque Bg1 over the caption-button
         block (MainWindow sizes it) and fades into the tint to its left, so the system glyphs
         stay covered without a visible block edge. Over the opaque fallback it is invisible. -->
    <LinearGradientBrush x:Key="CaptionStrip" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#0012161D" />
        <GradientStop Offset="0.42" Color="{StaticResource Bg1Color}" />
        <GradientStop Offset="1" Color="{StaticResource Bg1Color}" />
    </LinearGradientBrush>

    <!-- Caption buttons (Windows 11 values: SubtleFillColorSecondary/Tertiary, close red). -->
    <SolidColorBrush x:Key="CaptionHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="CaptionPressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="CaptionGlyphPressed" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="CaptionCloseHover" Color="#C42B1C" />
    <SolidColorBrush x:Key="CaptionClosePressed" Color="#E6C42B1C" />
    <SolidColorBrush x:Key="CaptionCloseGlyph" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CaptionCloseGlyphPressed" Color="#B3FFFFFF" />

    <!-- Metric series colors (shared by graphs, legends, and the overlay). -->
    <Color x:Key="SeriesClockColor">#58A6FF</Color>
    <Color x:Key="SeriesTempColor">#FF6B5B</Color>
    <Color x:Key="SeriesHotSpotColor">#FF9E7A</Color>
    <Color x:Key="SeriesPowerColor">#FFB84D</Color>
    <Color x:Key="SeriesUtilColor">#46C36B</Color>
    <Color x:Key="SeriesVramColor">#B18CFF</Color>
    <Color x:Key="SeriesFanColor">#4DD0E1</Color>
    <Color x:Key="SeriesFpsColor">#FF8A3C</Color>
    <Color x:Key="SeriesMemClockColor">#8CC5FF</Color>
    <Color x:Key="SeriesVoltageColor">#E3C15C</Color>

    <SolidColorBrush x:Key="SeriesClock" Color="{StaticResource SeriesClockColor}" />
    <SolidColorBrush x:Key="SeriesTemp" Color="{StaticResource SeriesTempColor}" />
    <SolidColorBrush x:Key="SeriesHotSpot" Color="{StaticResource SeriesHotSpotColor}" />
    <SolidColorBrush x:Key="SeriesPower" Color="{StaticResource SeriesPowerColor}" />
    <SolidColorBrush x:Key="SeriesUtil" Color="{StaticResource SeriesUtilColor}" />
    <SolidColorBrush x:Key="SeriesVram" Color="{StaticResource SeriesVramColor}" />
    <SolidColorBrush x:Key="SeriesFan" Color="{StaticResource SeriesFanColor}" />
    <SolidColorBrush x:Key="SeriesFps" Color="{StaticResource SeriesFpsColor}" />
    <SolidColorBrush x:Key="SeriesMemClock" Color="{StaticResource SeriesMemClockColor}" />
    <SolidColorBrush x:Key="SeriesVoltage" Color="{StaticResource SeriesVoltageColor}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
