<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\afterglow.ico</ApplicationIcon>
    <AssemblyName>Afterglow</AssemblyName>
    <RootNamespace>Afterglow.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Afterglow — open-source tuning and monitoring for NVIDIA RTX GPUs.</Description>
    <!-- CA1305: UI display strings intentionally format with the user's locale.
         Core (data, CSV, interop) remains strictly invariant-culture. -->
    <NoWarn>$(NoWarn);CA1305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Afterglow.Core\Afterglow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into the assembly: a loose file next to the exe was never
         copied to the output, so the tray fell back to the generic icon (F-68). -->
    <Resource Include="Assets\afterglow.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\ThirdParty\PresentMon\**"
          Link="ThirdParty\PresentMon\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
