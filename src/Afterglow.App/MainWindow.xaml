<Window x:Class="Afterglow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:shellx="clr-namespace:Afterglow.App.Shell"
        xmlns:views="clr-namespace:Afterglow.App.Views"
        xmlns:vm="clr-namespace:Afterglow.App.ViewModels"
        Title="Afterglow"
        Width="1280" Height="820" MinWidth="1024" MinHeight="660"
        Background="{StaticResource Bg0}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- GlassFrameThickness="1" is the opaque fallback. On Windows 11 22H2+ the code-behind
         switches to "-1" (whole window is DWM frame) when DWM accepts the Mica backdrop;
         see Shell/WindowEffects.cs. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="1"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TuningViewModel}">
            <views:TuningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FansViewModel}">
            <views:FansView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MetricsViewModel}">
            <views:MetricsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VfCurveViewModel}">
            <views:VfCurveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StabilityViewModel}">
            <views:StabilityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Windows 11 caption buttons: 46 DIP wide, full caption height, Segoe Fluent Icons
             glyphs (IconFont falls back to Segoe MDL2 Assets on Windows 10). Not tab stops,
             like the system ones: the keyboard route is Alt+Space / Win+Arrow, and UI
             Automation still invokes them by name. State colours are Style triggers (not
             template triggers) so the close and maximize styles can extend them. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Listed first so hover and press still win on an inactive window. -->
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                </DataTrigger>
                <!-- IsMouseOver/IsPressed for client-area buttons; NonClientButton.* for the
                     maximize button, whose mouse input Windows owns (Snap Layouts). -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CaptionHover}" />
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                </Trigger>
                <Trigger Property="shellx:NonClientButton.IsHovered" Value="True">
                    <Setter Property="Background" Value="{StaticResource CaptionHover}" />
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource CaptionPressed}" />
                    <Setter Property="Foreground" Value="{StaticResource CaptionGlyphPressed}" />
                </Trigger>
                <Trigger Property="shellx:NonClientButton.IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource CaptionPressed}" />
                    <Setter Property="Foreground" Value="{StaticResource CaptionGlyphPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MaximizeCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Content" Value="&#xE922;" />
            <Setter Property="AutomationProperties.Name" Value="Maximize" />
            <Setter Property="ToolTip" Value="Maximize" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;" />
                    <Setter Property="AutomationProperties.Name" Value="Restore" />
                    <Setter Property="ToolTip" Value="Restore down" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Content" Value="&#xE8BB;" />
            <Setter Property="AutomationProperties.Name" Value="Close" />
            <Setter Property="ToolTip" Value="Close" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CaptionCloseHover}" />
                    <Setter Property="Foreground" Value="{StaticResource CaptionCloseGlyph}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource CaptionClosePressed}" />
                    <Setter Property="Foreground" Value="{StaticResource CaptionCloseGlyphPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The window title dims with the window, as the system title does. -->
        <Style x:Key="WindowTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- RootGrid's Margin is set from code while maximized (WindowEffects.MaximizedFrameThickness):
         Windows parks the sizing frame of a maximized window off-screen, and WindowChrome
         turned that frame into client area. Each region paints its own surface (no window-wide
         fill) so that, with Mica, nothing stacks two translucent layers. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{DynamicResource ChromeSurface}">
            <!-- Opaque under the caption buttons (the right ~150 DIP) with ~110 DIP of fade
                 (42 % of 260): covers the glyphs DWM draws in the extended frame. First child,
                 so it never paints over the title or badges. -->
            <Border HorizontalAlignment="Right" Width="260" IsHitTestVisible="False"
                    Background="{StaticResource CaptionStrip}" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="Afterglow" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                           VerticalAlignment="Center" Style="{StaticResource WindowTitleText}" />
                <Border Background="{StaticResource Bg3}" CornerRadius="4" Padding="8,3" Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasMultipleGpus, Converter={x:Static views:Converters.InverseBoolToVisibility}}">
                    <TextBlock Text="{Binding GpuName}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                </Border>
                <!-- IsHitTestVisibleInChrome is required inside the 44px WindowChrome caption:
                     without it WM_NCHITTEST answers HTCAPTION here and a click drags the window
                     instead of opening the list. It is set on the ComboBox and not on the
                     StackPanel (it inherits) so the title text stays a drag handle. -->
                <ComboBox ItemsSource="{Binding GpuOptions}" SelectedIndex="{Binding SelectedGpuOption}"
                          FontSize="12" MinHeight="28" Padding="10,3,34,3" Margin="14,0,0,0" VerticalAlignment="Center" MinWidth="210"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True"
                          ToolTip="Every page follows the selected GPU; runs already in flight keep the card they started on"
                          Visibility="{Binding HasMultipleGpus, Converter={x:Static views:Converters.BoolToVisibility}}" />
                <Border Background="{StaticResource WarnSoft}" CornerRadius="4" Padding="8,3" Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowElevationBadge, Converter={x:Static views:Converters.BoolToVisibility}}">
                    <TextBlock Text="{Binding ElevationBadge}" FontSize="12" Foreground="{StaticResource Warn}" />
                </Border>
            </StackPanel>

            <!-- On Windows 11 the maximize button is answered as HTMAXBUTTON by
                 Shell/SnapLayoutHook.cs so hovering it opens Snap Layouts. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        AutomationProperties.Name="Minimize" ToolTip="Minimize" Click="OnMinimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeCaptionButton}" Click="OnMaximizeRestore" />
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="OnClose" />
            </StackPanel>
        </Grid>

        <!-- Crash-recovery + crash-forensics banners -->
        <StackPanel Grid.Row="1">
            <Border Background="{StaticResource WarnSurface}" BorderBrush="{StaticResource Warn}" BorderThickness="0,0,0,1"
                    Padding="16,10"
                    Visibility="{Binding ShowCrashBanner, Converter={x:Static views:Converters.BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CrashBannerText}" TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                               FontSize="14" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Reset to defaults"
                            Command="{Binding ResetAfterCrashCommand}" Margin="12,0,0,0" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Keep settings"
                            Command="{Binding DismissCrashBannerCommand}" Margin="8,0,0,0" />
                </Grid>
            </Border>
            <Border Background="{StaticResource WarnSurface}" BorderBrush="{StaticResource Warn}" BorderThickness="0,0,0,1"
                    Padding="16,10"
                    Visibility="{Binding ShowForensicsBanner, Converter={x:Static views:Converters.BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ForensicsBannerText}" TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                               FontSize="14" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="View crash report"
                            Command="{Binding ViewCrashReportCommand}" Margin="12,0,0,0" />
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Dismiss"
                            Command="{Binding DismissForensicsBannerCommand}" Margin="8,0,0,0" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource ChromeSurface}">
                <StackPanel Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource NavButton}" Content="Dashboard" Tag="&#xE9D2;"
                                 IsChecked="{Binding CurrentPageName, Mode=OneWay, Converter={x:Static views:PageMatchConverter.Instance}, ConverterParameter=dashboard}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="dashboard" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Tuning" Tag="&#xE945;"
                                 IsChecked="{Binding CurrentPageName, Mode=OneWay, Converter={x:Static views:PageMatchConverter.Instance}, ConverterParameter=tuning}" Command="{Binding NavigateToCommand}" CommandParameter="tuning" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Fans" Tag="&#xE72C;"
                                 IsChecked="{Binding CurrentPageName, Mode=OneWay, Converter={x:Static views:PageMatchConverter.Instance}, ConverterParameter=fans}" Command="{Binding NavigateToCommand}" CommandParameter="fans" />
                    <RadioButton Style="{StaticResource NavButton}" Content="FPS &amp; Frametimes" Tag="&#xEC4A;"
                                 IsChecked="{Binding CurrentPageName, Mode=OneWay, Converter={x:Static views:PageMatchConverter.Instance}, ConverterParameter=metrics}" Command="{Binding NavigateToCommand}" CommandParameter="metrics" />
                    <RadioButton Style="{StaticResource NavButton}" Content="V/F Curve" Tag="&#xE9D9;"
                                 IsChecked="{Binding CurrentPageName, Mode=OneWay, Converter={x:Static views:PageMatchConverter.Instance}, ConverterParameter=vfcurve}" Command="{Binding NavigateToCommand}" CommandParameter="vfcurve" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Stability" Tag="&#xEA80;"
                                 IsChecked="{Binding CurrentPageName, Mode=OneWay, Converter={x:Static views:PageMatchConverter.Instance}, ConverterParameter=stability}" Command="{Binding NavigateToCommand}" CommandParameter="stability" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Profiles" Tag="&#xE74E;"
                                 IsChecked="{Binding CurrentPageName, Mode=OneWay, Converter={x:Static views:PageMatchConverter.Instance}, ConverterParameter=profiles}" Command="{Binding NavigateToCommand}" CommandParameter="profiles" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" Tag="&#xE713;"
                                 IsChecked="{Binding CurrentPageName, Mode=OneWay, Converter={x:Static views:PageMatchConverter.Instance}, ConverterParameter=settings}" Command="{Binding NavigateToCommand}" CommandParameter="settings" />
                </StackPanel>
            </Border>

            <!-- The ContentControl is not a tab stop of its own: Tab goes straight into the page. -->
            <Border Grid.Column="1" Background="{DynamicResource ContentSurface}">
                <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource ChromeSurface}" BorderBrush="{StaticResource StrokeSoft}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock Text="{Binding DriverText}" FontSize="12" Foreground="{StaticResource TextFaint}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
